  m_TableData:
  - m_Id: 26482757632
    m_Localized: El jugador no existe
    m_Metadata:
      m_Items: []
  - m_Id: 26516312064
    m_Localized: "Objetivo no v\xE1lido"
    m_Metadata:
      m_Items: []
  - m_Id: 26520506368
    m_Localized: No se puede lanzar estando muerto
    m_Metadata:
      m_Items: []
  - m_Id: 26520506369
    m_Localized: Fuera de alcance
    m_Metadata:
      m_Items: []
  - m_Id: 26524700672
    m_Localized: "El objetivo ya est\xE1 muerto"
    m_Metadata:
      m_Items: []
  - m_Id: 26524700673
    m_Localized: No se puede marcar al jugador como objetivo
    m_Metadata:
      m_Items: []
  - m_Id: 26524700674
    m_Localized: "El hechizo a\xFAn no est\xE1 listo"
    m_Metadata:
      m_Items: []
  - m_Id: 26524700675
    m_Localized: Solo se pueden marcar objetivos muertos
    m_Metadata:
      m_Items: []
  - m_Id: 26524700676
    m_Localized: "\xA1Error de conexi\xF3n, tiempo agotado!"
    m_Metadata:
      m_Items: []
  - m_Id: 26524700677
    m_Localized: "\xA1Error al conectar con el maestro!"
    m_Metadata:
      m_Items: []
  - m_Id: 26524700678
    m_Localized: "\xA1Error al conectar con la sesi\xF3n!"
    m_Metadata:
      m_Items: []
  - m_Id: 26524700679
    m_Localized: "\xA1Error de conexi\xF3n, token de cliente no v\xE1lido!"
    m_Metadata:
      m_Items: []
  - m_Id: 26524700680
    m_Localized: "\xA1Error de conexi\xF3n, versi\xF3n no v\xE1lida!"
    m_Metadata:
      m_Items: []
  - m_Id: 26524700681
    m_Localized: "\xA1Error de conexi\xF3n!"
    m_Metadata:
      m_Items: []
  - m_Id: 26524700682
    m_Localized: "\xA1Error de conexi\xF3n, el servidor rechaz\xF3 la conexi\xF3n!"
    m_Metadata:
      m_Items: []
  - m_Id: 26524700683
    m_Localized: "\xA1Error de conexi\xF3n, dispositivo no compatible!"
    m_Metadata:
      m_Items: []
  - m_Id: 26524700684
    m_Localized: "\xA1Conectado!"
    m_Metadata:
      m_Items: []
  - m_Id: 26524700685
    m_Localized: Iniciando cliente...
    m_Metadata:
      m_Items: []
  - m_Id: 26524700686
    m_Localized: Error al iniciar el cliente
    m_Metadata:
      m_Items: []
  - m_Id: 26524700687
    m_Localized: "\xA1Cliente iniciado!"
    m_Metadata:
      m_Items: []
  - m_Id: 26524700688
    m_Localized: Conectando...
    m_Metadata:
      m_Items: []
  - m_Id: 26524700689
    m_Localized: "\xA1Sesi\xF3n finalizada! Motivo: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 26524700690
    m_Localized: Iniciando servidor...
    m_Metadata:
      m_Items: []
  - m_Id: 26524700691
    m_Localized: Error al iniciar el servidor
    m_Metadata:
      m_Items: []
  - m_Id: 26524700692
    m_Localized: "\xA1Servidor iniciado!"
    m_Metadata:
      m_Items: []
  - m_Id: 26524700693
    m_Localized: "Falta localizaci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 26524700694
    m_Localized: No se puede lanzar en movimiento
    m_Metadata:
      m_Items: []
  - m_Id: 26524700695
    m_Localized: "El objetivo no est\xE1 congelado"
    m_Metadata:
      m_Items: []
  - m_Id: 26524700696
    m_Localized: Silenciado
    m_Metadata:
      m_Items: []
  - m_Id: 26524700697
    m_Localized: Pacificado
    m_Metadata:
      m_Items: []
  - m_Id: 26524700698
    m_Localized: "No puedes hacer eso mientras est\xE1s confundido"
    m_Metadata:
      m_Items: []
  - m_Id: 26524700699
    m_Localized: No puedes hacer eso mientras huyes
    m_Metadata:
      m_Items: []
  - m_Id: 26524700700
    m_Localized: "No puedes hacer eso mientras est\xE1s aturdido"
    m_Metadata:
      m_Items: []
  - m_Id: 26524700701
    m_Localized: "Absorci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 26524700702
    m_Localized: Inmune
    m_Metadata:
      m_Items: []
  - m_Id: 26524700703
    m_Localized: Esquivado
    m_Metadata:
      m_Items: []
  - m_Id: 26524700704
    m_Localized: Evadido
    m_Metadata:
      m_Items: []
  - m_Id: 26524700705
    m_Localized: Fallo
    m_Metadata:
      m_Items: []
  - m_Id: 26524700706
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 26524700707
    m_Localized: "Flexi\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 26524700708
    m_Localized: Suplicar
    m_Metadata:
      m_Items: []
  - m_Id: 26524700709
    m_Localized: "Inclinaci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 26524700710
    m_Localized: Pollo
    m_Metadata:
      m_Items: []
  - m_Id: 26524700711
    m_Localized: Llorar
    m_Metadata:
      m_Items: []
  - m_Id: 26524700712
    m_Localized: Bailar
    m_Metadata:
      m_Items: []
  - m_Id: 26524700713
    m_Localized: Beso
    m_Metadata:
      m_Items: []
  - m_Id: 26524700714
    m_Localized: "Re\xEDr"
    m_Metadata:
      m_Items: []
  - m_Id: 26524700715
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 26524700716
    m_Localized: "Se\xF1alar"
    m_Metadata:
      m_Items: []
  - m_Id: 26524700717
    m_Localized: Leer
    m_Metadata:
      m_Items: []
  - m_Id: 26524700718
    m_Localized: Rugir
    m_Metadata:
      m_Items: []
  - m_Id: 26524700719
    m_Localized: Grosero
    m_Metadata:
      m_Items: []
  - m_Id: 26524700720
    m_Localized: Gritar
    m_Metadata:
      m_Items: []
  - m_Id: 26524700721
    m_Localized: "T\xEDmido"
    m_Metadata:
      m_Items: []
  - m_Id: 26524700722
    m_Localized: Hablar
    m_Metadata:
      m_Items: []
  - m_Id: 26524700723
    m_Localized: "Exclamaci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 26524700724
    m_Localized: Pregunta
    m_Metadata:
      m_Items: []
  - m_Id: 26524700725
    m_Localized: Tren
    m_Metadata:
      m_Items: []
  - m_Id: 26524700726
    m_Localized: Saludar
    m_Metadata:
      m_Items: []
  - m_Id: 26524700727
    m_Localized: "S\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 26524700728
    m_Localized: "Acelera tus lanzamientos de hechizos durante {0} s, otorgando un
      {1}% de celeridad, un {2}% de bonificaci\xF3n de da\xF1o cr\xEDtico y evitando
      que el da\xF1o retrase tus lanzamientos."
    m_Metadata:
      m_Items: []
  - m_Id: 26524700729
    m_Localized: "Venas g\xE9lidas"
    m_Metadata:
      m_Items: []
  - m_Id: 26524700730
    m_Localized: "Aturde al objetivo durante {0} s y hace que se lo considere congelado
      mientras dure el aturdimiento.\n\nSolo se puede usar con objetivos congelados
      o mientras el lanzador est\xE9 afectado por Dedos de Escarcha."
    m_Metadata:
      m_Items: []
  - m_Id: 26524700731
    m_Localized: "Congelaci\xF3n profunda"
    m_Metadata:
      m_Items: []
  - m_Id: 26524700732
    m_Localized: "Infuya brillantez al objetivo, aumentando su Intelecto un {0}%
      durante {1} segundos.\n\nSi el objetivo est\xE1 en tu grupo o banda, todos
      los miembros se ver\xE1n afectados."
    m_Metadata:
      m_Items: []
  - m_Id: 26524700733
    m_Localized: Intelecto arcano
    m_Metadata:
      m_Items: []
  - m_Id: 26524700734
    m_Localized: "Suprime los efectos que ralentizan el movimiento y aumenta tu velocidad
      de movimiento un {0}% durante {1} s.\n\nSe puede lanzar mientras otro hechizo
      est\xE1 en curso y no se ve afectado por el tiempo de reutilizaci\xF3n global."
    m_Metadata:
      m_Items: []
  - m_Id: 26524700735
    m_Localized: Velocidad abrasadora
    m_Metadata:
      m_Items: []
  - m_Id: 26524700736
    m_Localized: "Te teletransporta {0} m hacia adelante o hasta alcanzar un obst\xE1culo,
      y te libera de todos los aturdimientos y v\xEDnculos.\n\nSe puede usar mientras
      est\xE1s aturdido."
    m_Metadata:
      m_Items: []
  - m_Id: 26528894976
    m_Localized: "Traslaci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 26528894977
    m_Localized: "Los objetivos en un cono frente a ti reciben ({0}% del poder con
      hechizos) de da\xF1o de Escarcha y su movimiento se ralentiza un {1}% durante
      {2} s.\n\nTiene un {3:P0} de probabilidad de activar Dedos de Escarcha."
    m_Metadata:
      m_Items: []
  - m_Id: 26528894978
    m_Localized: "Cono de fr\xEDo"
    m_Metadata:
      m_Items: []
  - m_Id: 26528894979
    m_Localized: "Contrarresta el lanzamiento de hechizos del enemigo, evitando que
      se lance cualquier hechizo de esa escuela de magia durante {0} s.\n\nSe puede
      lanzar mientras otro hechizo est\xE1 en curso y no se ve afectado por el tiempo
      de reutilizaci\xF3n global."
    m_Metadata:
      m_Items: []
  - m_Id: 26528894980
    m_Localized: Contihechizo
    m_Metadata:
      m_Items: []
  - m_Id: 26528894981
    m_Localized: "Golpea al enemigo por ({0}% del poder con hechizos) de da\xF1o
      de Fuego.\n\nSiempre inflige un golpe cr\xEDtico y hace que se active Calentamiento,
      a menos que el objetivo sea inmune a los golpes cr\xEDticos.\n\nSe puede lanzar
      mientras otro hechizo est\xE1 en curso y no se ve afectado por el tiempo de
      reutilizaci\xF3n global."
    m_Metadata:
      m_Items: []
  - m_Id: 26528894982
    m_Localized: "Explosi\xF3n de Fuego"
    m_Metadata:
      m_Items: []
  - m_Id: 26528894983
    m_Localized: "Invoca un pilar de fuego que quema a todos los enemigos en el \xE1rea
      por ({0}% del poder con hechizos) de da\xF1o de Fuego y ({1}% adicionales del
      poder con hechizos) cada {2} s durante {3} s."
    m_Metadata:
      m_Items: []
  - m_Id: 26528894984
    m_Localized: Fogonazo
    m_Metadata:
      m_Items: []
  - m_Id: 26528894985
    m_Localized: "Un hechizo r\xE1pido que sana a un aliado ({0}% del poder con hechizos)."
    m_Metadata:
      m_Items: []
  - m_Id: 26528894986
    m_Localized: "Sanaci\xF3n rel\xE1mpago"
    m_Metadata:
      m_Items: []
  - m_Id: 26528894987
    m_Localized: "Lanza una descarga de escarcha al enemigo, infligiendo ({0}% del
      poder con hechizos) de da\xF1o de Escarcha y ralentizando la velocidad de movimiento
      un {1}% durante {2} s.\n\nTiene un {3:P0} de probabilidad de activar Dedos
      de Escarcha."
    m_Metadata:
      m_Items: []
  - m_Id: 26528894988
    m_Localized: Descarga de Escarcha
    m_Metadata:
      m_Items: []
  - m_Id: 26528894989
    m_Localized: "Golpea a los enemigos en un radio de {0} m por ({1}% del poder
      con hechizos) de da\xF1o de Escarcha y los congela en el sitio durante {2}
      s.\n\nEl da\xF1o puede interrumpir el efecto de congelaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 26528894990
    m_Localized: Nueva de Escarcha
    m_Metadata:
      m_Items: []
  - m_Id: 26528894991
    m_Localized: Realiza un milagro, sanando a un aliado ({0}% del poder con hechizos).
    m_Metadata:
      m_Items: []
  - m_Id: 26528894992
    m_Localized: 'Palabra Sagrada: Serenidad'
    m_Metadata:
      m_Items: []
  - m_Id: 26528894993
    m_Localized: "Elimina todos los efectos de reducci\xF3n de movimiento y todos
      los efectos que provocan la p\xE9rdida de control de tu personaje mientras
      est\xE1s en combate JcJ."
    m_Metadata:
      m_Items: []
  - m_Id: 26528894994
    m_Localized: "Medall\xF3n honorable"
    m_Metadata:
      m_Items: []
  - m_Id: 26528894995
    m_Localized: "Te protege con hielo, absorbiendo un ({0}% de la salud total) de
      da\xF1o. Dura {1} s.\n\nMientras el escudo resista, los hechizos no se interrumpir\xE1n."
    m_Metadata:
      m_Items: []
  - m_Id: 26528894996
    m_Localized: Barrera de hielo
    m_Metadata:
      m_Items: []
  - m_Id: 26528894997
    m_Localized: "Te envuelve en un bloque de hielo, protegi\xE9ndote de todos los
      ataques y da\xF1os durante {0} s, pero durante ese tiempo no puedes atacar,
      moverte ni lanzar hechizos."
    m_Metadata:
      m_Items: []
  - m_Id: 26528894998
    m_Localized: Bloque de hielo
    m_Metadata:
      m_Items: []
  - m_Id: 26528894999
    m_Localized: "Lanza r\xE1pidamente un fragmento de hielo al objetivo, infligiendo
      ({0}% del poder con hechizos) de da\xF1o de Escarcha.\n\nEl da\xF1o de Lanza
      de hielo se cuadruplica contra objetivos congelados. Tambi\xE9n se considera
      que los objetivos est\xE1n congelados si el lanzador est\xE1 bajo el efecto
      de Dedos de Escarcha.\n\nEl da\xF1o aumenta un {1}% al consumir una carga de
      Dedos de Escarcha."
    m_Metadata:
      m_Items: []
  - m_Id: 26528895000
    m_Localized: Lanza de hielo
    m_Metadata:
      m_Items: []
  - m_Id: 26528895001
    m_Localized: "Provoca un torbellino de viento g\xE9lido alrededor del enemigo,
      infligiendo ({0}% del poder con hechizos) de da\xF1o de Escarcha al objetivo
      y a todos los dem\xE1s enemigos en un radio de {1} m, y congel\xE1ndolos en
      el sitio durante {2} s.\n\nEl da\xF1o puede interrumpir el efecto de congelaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 26528895002
    m_Localized: Nueva de hielo
    m_Metadata:
      m_Items: []
  - m_Id: 26528895003
    m_Localized: "Mata instant\xE1neamente al objetivo actual.\n\nHechizo de depuraci\xF3n
      temporal, solo se puede usar contra criaturas."
    m_Metadata:
      m_Items: []
  - m_Id: 26528895004
    m_Localized: Matar criatura
    m_Metadata:
      m_Items: []
  - m_Id: 26528895005
    m_Localized: "Mata instant\xE1neamente al lanzador.\n\nHechizo de depuraci\xF3n
      temporal."
    m_Metadata:
      m_Items: []
  - m_Id: 26528895006
    m_Localized: Suicidarse
    m_Metadata:
      m_Items: []
  - m_Id: 26528895007
    m_Localized: "El objetivo se convierte en una bomba viva, recibiendo ({0}% del
      poder con hechizos) de da\xF1o de Fuego cada {4} s durante {1} s, y luego explota
      para infligir ({2}% adicionales del poder con hechizos) de da\xF1o de Fuego
      al objetivo y a todos los dem\xE1s enemigos en un radio de {3} m.\n\nCuando
      se aplica por primera vez, inflige da\xF1o de pulso inmediato. El temporizador
      de explosi\xF3n se reinicia al renovar la duraci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 26528895008
    m_Localized: Bomba viva
    m_Metadata:
      m_Items: []
  - m_Id: 26528895009
    m_Localized: "Reduce todo el da\xF1o recibido por un objetivo amistoso un {0}%
      durante {1} s.\n\nSe puede lanzar mientras est\xE1s aturdido."
    m_Metadata:
      m_Items: []
  - m_Id: 26528895010
    m_Localized: "Supresi\xF3n de dolor"
    m_Metadata:
      m_Items: []
  - m_Id: 26528895011
    m_Localized: "Transforma al enemigo en una oveja, haci\xE9ndolo deambular incapacitado
      durante {0} s. Mientras est\xE9 afectado, la v\xEDctima no puede realizar acciones.\n\nCualquier
      da\xF1o cancelar\xE1 el efecto."
    m_Metadata:
      m_Items: []
  - m_Id: 26528895012
    m_Localized: Polimorfia
    m_Metadata:
      m_Items: []
  - m_Id: 26528895013
    m_Localized: "Cuando se activa, tu pr\xF3ximo hechizo de mago con un tiempo de
      lanzamiento inferior a 10 s se vuelve instant\xE1neo."
    m_Metadata:
      m_Items: []
  - m_Id: 26528895014
    m_Localized: Presencia mental
    m_Metadata:
      m_Items: []
  - m_Id: 26528895015
    m_Localized: "Lanza una inmensa roca de fuego que causa ({0}% del poder con hechizos)
      de da\xF1o de Fuego y ({1}% adicionales) cada {2} s durante {3} s.\n\nObtener
      dos golpes cr\xEDticos directos seguidos har\xE1 que tu siguiente Piroexplosi\xF3n
      sea instant\xE1nea."
    m_Metadata:
      m_Items: []
  - m_Id: 26528895016
    m_Localized: "Piroexplosi\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 26528895017
    m_Localized: "Infundir fe en la luz al objetivo, san\xE1ndolo instant\xE1neamente
      ({0}% del poder con hechizos) y luego ({1}% del poder con hechizos) cada {2}
      s durante {3} s."
    m_Metadata:
      m_Items: []
  - m_Id: 26528895018
    m_Localized: Renovar
    m_Metadata:
      m_Items: []
  - m_Id: 26528895019
    m_Localized: 'El lanzador resucita con un 50% de salud.


      Solo se puede
      usar estando muerto.'
    m_Metadata:
      m_Items: []
  - m_Id: 26528895020
    m_Localized: Resucitarse
    m_Metadata:
      m_Items: []
  - m_Id: 26528895021
    m_Localized: "Agosta a un enemigo por ({0}% del poder con hechizos) de da\xF1o
      de Fuego.\n\nSe puede lanzar en movimiento.\n\nPuede activar Calentamiento
      tras obtener 2 golpes cr\xEDticos seguidos."
    m_Metadata:
      m_Items: []
  - m_Id: 26528895022
    m_Localized: Agostar
    m_Metadata:
      m_Items: []
  - m_Id: 26528895023
    m_Localized: '{0} m de alcance'
    m_Metadata:
      m_Items: []
  - m_Id: 26528895024
    m_Localized: "{0} s de tiempo de reutilizaci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 26528895025
    m_Localized: "Instant\xE1neo"
    m_Metadata:
      m_Items: []
  - m_Id: 26528895026
    m_Localized: 'Lanzamiento: {0} s'
    m_Metadata:
      m_Items: []
  - m_Id: 26528895027
    m_Localized: General
    m_Metadata:
      m_Items: []
  - m_Id: 26528895028
    m_Localized: Hechizo desconocido
    m_Metadata:
      m_Items: []
  - m_Id: 26528895029
    m_Localized: "Cambia a forma felina, lo que aumenta la velocidad de movimiento
      un {0}%, otorga protecci\xF3n contra efectos de Polimorfia y reduce el da\xF1o
      por ca\xEDda.\n\nEl acto de cambiar de forma te libera de los efectos de reducci\xF3n
      de movimiento."
    m_Metadata:
      m_Items: []
  - m_Id: 26528895030
    m_Localized: Forma felina
    m_Metadata:
      m_Items: []
  - m_Id: 26528895031
    m_Localized: Druida
    m_Metadata:
      m_Items: []
  - m_Id: 26528895032
    m_Localized: Mago
    m_Metadata:
      m_Items: []
  - m_Id: 26528895033
    m_Localized: "Ara\xF1a al objetivo infligiendo ({0}% del poder de ataque) de
      da\xF1o de Sangrado y ({1}% adicionales) cada {2} s durante {3} s.\n\nReduce
      la velocidad de movimiento del objetivo un {4}%.\n\nOtorga 1 punto de combo."
    m_Metadata:
      m_Items: []
  - m_Id: 26528895034
    m_Localized: "Ara\xF1azo"
    m_Metadata:
      m_Items: []
  - m_Id: 26528895035
    m_Localized: "Tritura al objetivo, infligiendo ({0}% del poder de ataque + 20)
      de da\xF1o f\xEDsico.\n\nInflige un 50% m\xE1s de da\xF1o contra objetivos
      que sangran.\n\nOtorga 2 puntos de combo."
    m_Metadata:
      m_Items: []
  - m_Id: 26528895036
    m_Localized: Triturar
    m_Metadata:
      m_Items: []
  - m_Id: 26528895037
    m_Localized: "Golpea a los enemigos cercanos, infligiendo ({0}% del poder de
