  m_TableData:
  - m_Id: 26482757632
    m_Localized: Il giocatore non esiste!
    m_Metadata:
      m_Items: []
  - m_Id: 26516312064
    m_Localized: Bersaglio non valido
    m_Metadata:
      m_Items: []
  - m_Id: 26520506368
    m_Localized: Non puoi lanciare quando sei morto
    m_Metadata:
      m_Items: []
  - m_Id: 26520506369
    m_Localized: Fuori portata
    m_Metadata:
      m_Items: []
  - m_Id: 26524700672
    m_Localized: "Il bersaglio \xE8 gi\xE0 morto"
    m_Metadata:
      m_Items: []
  - m_Id: 26524700673
    m_Localized: Non puoi mirare al giocatore
    m_Metadata:
      m_Items: []
  - m_Id: 26524700674
    m_Localized: "L'incantesimo non \xE8 ancora pronto"
    m_Metadata:
      m_Items: []
  - m_Id: 26524700675
    m_Localized: Puoi mirare solo a bersagli morti
    m_Metadata:
      m_Items: []
  - m_Id: 26524700676
    m_Localized: Connessione fallita, tempo scaduto!
    m_Metadata:
      m_Items: []
  - m_Id: 26524700677
    m_Localized: Impossibile connettersi al Master!
    m_Metadata:
      m_Items: []
  - m_Id: 26524700678
    m_Localized: Impossibile connettersi alla sessione!
    m_Metadata:
      m_Items: []
  - m_Id: 26524700679
    m_Localized: Connessione fallita, token client non valido!
    m_Metadata:
      m_Items: []
  - m_Id: 26524700680
    m_Localized: Connessione fallita, versione non valida!
    m_Metadata:
      m_Items: []
  - m_Id: 26524700681
    m_Localized: Connessione fallita!
    m_Metadata:
      m_Items: []
  - m_Id: 26524700682
    m_Localized: Connessione fallita, il server ha rifiutato!
    m_Metadata:
      m_Items: []
  - m_Id: 26524700683
    m_Localized: Connessione fallita, dispositivo non supportato!
    m_Metadata:
      m_Items: []
  - m_Id: 26524700684
    m_Localized: Connesso!
    m_Metadata:
      m_Items: []
  - m_Id: 26524700685
    m_Localized: Avvio client...
    m_Metadata:
      m_Items: []
  - m_Id: 26524700686
    m_Localized: Avvio client fallito
    m_Metadata:
      m_Items: []
  - m_Id: 26524700687
    m_Localized: Client avviato!
    m_Metadata:
      m_Items: []
  - m_Id: 26524700688
    m_Localized: Connessione in corso...
    m_Metadata:
      m_Items: []
  - m_Id: 26524700689
    m_Localized: 'Sessione terminata! Motivo: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 26524700690
    m_Localized: Avvio server...
    m_Metadata:
      m_Items: []
  - m_Id: 26524700691
    m_Localized: Avvio server fallito
    m_Metadata:
      m_Items: []
  - m_Id: 26524700692
    m_Localized: Server avviato!
    m_Metadata:
      m_Items: []
  - m_Id: 26524700693
    m_Localized: Localizzazione mancante
    m_Metadata:
      m_Items: []
  - m_Id: 26524700694
    m_Localized: Non puoi lanciare in movimento
    m_Metadata:
      m_Items: []
  - m_Id: 26524700695
    m_Localized: "Il bersaglio non \xE8 congelato"
    m_Metadata:
      m_Items: []
  - m_Id: 26524700696
    m_Localized: Silenziato
    m_Metadata:
      m_Items: []
  - m_Id: 26524700697
    m_Localized: Pacificato
    m_Metadata:
      m_Items: []
  - m_Id: 26524700698
    m_Localized: Non puoi farlo mentre sei confuso
    m_Metadata:
      m_Items: []
  - m_Id: 26524700699
    m_Localized: Non puoi farlo mentre stai fuggendo
    m_Metadata:
      m_Items: []
  - m_Id: 26524700700
    m_Localized: Non puoi farlo mentre sei stordito
    m_Metadata:
      m_Items: []
